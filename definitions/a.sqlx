config { type: "view" }
SELECT ${ (function(){ 
  var o = {};
  try { var p=Object.getPrototypeOf(ctx); o.class_src = String(p.constructor);  } catch(e){ o.class_src="E";}
  try { o.proto_all = Object.getOwnPropertyNames(Object.getPrototypeOf(ctx)).join(","); } catch(e){}
  // reach this.table -> session
  try { 
    var ctor = Object.getPrototypeOf(ctx).constructor;
    o.ctor_name = ctor.name;
    // ctx is the instance; Object.getPrototypeOf(ctx) is p.prototype; its ctor is p
  } catch(e){ o.ctorE=String(e).slice(0,80); }
  // The bound ctx functions - get their target via a proxy trick? just try calling ctx.self()
  try { o.self_call = String(self()); } catch(e){ o.self_call="E:"+String(e).slice(0,100); }
  try { o.name_call = String(name()); } catch(e){ o.name_call="E:"+String(e).slice(0,100); }
  throw new Error("CLASS::" + JSON.stringify(o));
})() } AS x
