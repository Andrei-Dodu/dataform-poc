config { type: "view" }
SELECT ${ (function(){ 
  var o = {};
  // ctx is the `p` instance; ctx's own props are table,isIncremental -> table.session
  try { o.table_keys = Object.getOwnPropertyNames(ctx).join(","); } catch(e){}
  try { o.table_type = Object.prototype.toString.call(ctx.table); } catch(e){}
  try {
    var tb = ctx.table;
    o.tb_keys = Object.getOwnPropertyNames(tb).join(",");
    var s = tb.session;
    o.session_keys = Object.getOwnPropertyNames(s).join(",");
    o.session_proto = Object.getOwnPropertyNames(Object.getPrototypeOf(s)).join(",");
  } catch(e){ o.E = String(e).slice(0,150); }
  throw new Error("SESSION::" + JSON.stringify(o));
})() } AS x
