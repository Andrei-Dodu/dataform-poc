config { type: "view" }
SELECT ${ (function(){ 
  var o = {};
  var s = ctx.table.session;
  // source of the interesting methods
  ["compileToBase64","compile","compileGraphChunk","resolve","finalizeDatabase"].forEach(function(m){
    try { o[m] = String(s[m]).slice(0,220); } catch(e){ o[m]="E"; }
  });
  // is there anything in the session referencing host/fs/net?
  try { o.projCfg = JSON.stringify(s.projectConfig).slice(0,200); } catch(e){}
  try { o.rootDir = String(s.rootDir); } catch(e){}
  throw new Error("SM::" + JSON.stringify(o));
})() } AS x
